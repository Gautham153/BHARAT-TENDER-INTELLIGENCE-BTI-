rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGovernmentUser() {
      return isSignedIn() && (
        (request.auth.token.role == 'government') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'government')
      );
    }

    function isAgencyUser() {
      return isSignedIn() && (
        (request.auth.token.role == 'agency') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agency')
      );
    }

    function isVerifiedAgency() {
      return isAgencyUser() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified'
      );
    }

    function getUserOrgId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId
        : '';
    }

    function isValidProposalStatusTransition(prev, next) {
      return prev == next
        || (prev == 'DRAFT' && next == 'SUBMITTED')
        || (prev == 'SUBMITTED' && (next in ['UNDER_REVIEW', 'WITHDRAWN']))
        || (prev == 'UNDER_REVIEW' && (next in ['SHORTLISTED', 'REJECTED']))
        || (prev == 'SHORTLISTED' && (next in ['AWARDED', 'REJECTED']));
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.role in ['government', 'agency', 'public']
        && data.verificationStatus in ['not_started', 'pending', 'verified', 'failed', 'requires_review'];
    }

    // Authoritative tender status transition validator
    // Enforces strict unidirectional and legal state transitions:
    // DRAFT -> PUBLISHED/LIVE -> CLOSED -> UNDER_EVALUATION -> AWARDED -> ARCHIVED (with legal cancellation paths)
    function isValidStatusTransition(prev, next) {
      return prev == next
        || (prev == 'DRAFT' && (next in ['DRAFT', 'PUBLISHED', 'LIVE', 'CANCELLED']))
        || (prev in ['PUBLISHED', 'LIVE', 'Open'] && (next in ['LIVE', 'CLOSED', 'CANCELLED']))
        || (prev == 'CLOSED' && (next in ['UNDER_EVALUATION', 'ARCHIVED']))
        || (prev == 'UNDER_EVALUATION' && (next in ['AWARDED', 'CANCELLED']))
        || (prev == 'AWARDED' && (next == 'ARCHIVED'))
        || (prev == 'CANCELLED' && (next == 'ARCHIVED'));
    }

    // 2. Users Collection Rules (/users/{uid})
    match /users/{uid} {
      // Individual document read allowed for the account owner or verified government personnel
      allow get: if isSignedIn() && isValidId(uid) && (
        request.auth.uid == uid || isGovernmentUser()
      );

      // Query listings strictly restricted to user's own record
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Registration: User can create their profile only for themselves with role 'agency' and status 'pending'
      // Preventing privilege escalation: self-assigned 'government' role or pre-verified status is forbidden.
      allow create: if isSignedIn() 
        && isValidId(uid) 
        && request.auth.uid == uid
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'agency'
        && incoming().verificationStatus == 'pending'
        && incoming().verified == false;

      // Updates: Account owner can update non-privileged profile information
      allow update: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().verificationStatus == existing().verificationStatus
        && incoming().verified == existing().verified
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phone', 'designation', 'organizationName', 'address', 'businessCategory', 'updatedAt'
        ]);

      // Updates by Government Nodal Reviewer (can update verification status and verified flag during adjudication)
      allow update: if isGovernmentUser()
        && isValidId(uid)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'verified', 'verificationStatus', 'updatedAt'
        ]);

      // Direct document deletion forbidden from client
      allow delete: if false;
    }

    // 3. Organizations Collection Rules (/organizations/{organizationId})
    match /organizations/{organizationId} {
      // Read allowed for the primary organization user or verified government personnel
      allow get: if isSignedIn() && isValidId(organizationId) && (
        resource == null || resource.data.primaryUserId == request.auth.uid || isGovernmentUser()
      );

      // List allowed for primary user or government reviewers
      allow list: if isSignedIn() && (
        resource.data.primaryUserId == request.auth.uid || isGovernmentUser()
      );

      // Create: Agency user only can create organization record for their own UID.
      // Requires authenticated agency profile in /users/{uid} and unverified initial state.
      allow create: if isSignedIn()
        && isValidId(organizationId)
        && incoming().primaryUserId == request.auth.uid
        && isAgencyUser()
        && incoming().gstin is string && incoming().gstin.size() == 15
        && (incoming().verificationStatus in ['pending', 'not_started'])
        && incoming().verified == false;

      // Update by Government Nodal Reviewer (restricted strictly to adjudication state fields)
      allow update: if isGovernmentUser()
        && isValidId(organizationId)
        && incoming().organizationId == existing().organizationId
        && incoming().gstin == existing().gstin
        && incoming().primaryUserId == existing().primaryUserId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'verificationStatus', 'btiAuthorizationStatus', 'verified', 'verificationCompletedAt', 'rejectionReason', 'reviewNotes', 'updatedAt'
        ]);

      // Update by Agency Owner (cannot tamper with verification status or GSTIN)
      allow update: if isSignedIn()
        && isValidId(organizationId)
        && request.auth.uid == existing().primaryUserId
        && incoming().organizationId == existing().organizationId
        && incoming().gstin == existing().gstin
        && incoming().primaryUserId == existing().primaryUserId
        && incoming().verificationStatus == existing().verificationStatus
        && incoming().verified == existing().verified
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'registeredAddress', 'contactEmail', 'contactPhone', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // 4. Verification Events Audit Log (/verificationEvents/{eventId})
    // Audit records are strictly append-only (no updates, no deletions)
    match /verificationEvents/{eventId} {
      // Agency users may read events only for organizations they own
      function isOrgOwnerForEvent() {
        return isAgencyUser()
          && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId))
          && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.primaryUserId == request.auth.uid;
      }

      // Read single event: authorized government reviewer or agency owner of the organization
      allow get: if isSignedIn() && isValidId(eventId) && (
        isGovernmentUser() || isOrgOwnerForEvent()
      );

      // List audit events: authorized government reviewer or agency owner of the organization
      allow list: if isSignedIn() && (
        isGovernmentUser() || isOrgOwnerForEvent()
      );

      // Agency audit action validation: only owner agency can create SUBMITTED or RETRY_REQUESTED events for their own org
      function isAgencyEventValid() {
        return isAgencyUser()
          && incoming().actorId == request.auth.uid
          && incoming().actorRole == 'agency'
          && incoming().action in ['SUBMITTED', 'RETRY_REQUESTED']
          && exists(/databases/$(database)/documents/organizations/$(incoming().organizationId))
          && get(/databases/$(database)/documents/organizations/$(incoming().organizationId)).data.primaryUserId == request.auth.uid;
      }

      // Government nodal review audit action validation: government reviewers can record review/adjudication events
      function isGovEventValid() {
        return isGovernmentUser()
          && incoming().actorId == request.auth.uid
          && incoming().actorRole == 'government'
          && incoming().action in ['MARKED_FOR_REVIEW', 'APPROVED', 'REJECTED']
          && exists(/databases/$(database)/documents/organizations/$(incoming().organizationId));
      }

      // Append new audit event - strictly enforced by actor role authorization matrix & ownership
      allow create: if isSignedIn()
        && isValidId(eventId)
        && (isAgencyEventValid() || isGovEventValid());

      // Audit logs are strictly immutable
      allow update, delete: if false;
    }

    // 5. Tenders Collection Rules (/tenders/{tenderId})
    match /tenders/{tenderId} {
      // Helper to check active published status and non-expired deadline for agency discovery & detail access.
      // Agency users are strictly restricted to active LIVE tenders whose closing deadline is strictly in the future.
      // DRAFT, CLOSED, UNDER_EVALUATION, AWARDED, CANCELLED, ARCHIVED, or tenders where closingDate <= request.time are forbidden.
      function isActiveAndNotExpired(data) {
        return (data.status in ['PUBLISHED', 'LIVE', 'Open'])
          && (data.closingDate is timestamp)
          && (data.closingDate > request.time);
      }

      // Read single tender:
      // Government users retain full lifecycle visibility across all statuses (including DRAFT, CLOSED, ARCHIVED, and expired).
      // Authenticated agency users can only read active LIVE procurement notices whose deadline has not elapsed.
      allow get: if isSignedIn() && isValidId(tenderId) && (
        isGovernmentUser() || (isAgencyUser() && isActiveAndNotExpired(resource.data))
      );

      // List tenders:
      // Government users can list all tenders across full lifecycle.
      // Authenticated agency users can query active published procurement notices deterministically.
      allow list: if isSignedIn() && (
        isGovernmentUser() || (isAgencyUser() && resource.data.status in ['PUBLISHED', 'LIVE', 'Open'])
      );

      // Create tender:
      // Restricted strictly to authenticated government personnel.
      // Must set createdBy to the user's UID and status to DRAFT or PUBLISHED/LIVE.
      // DRAFT may omit closingDate; PUBLISHED/LIVE tenders must persist closingDate as a valid Firestore Timestamp.
      allow create: if isGovernmentUser()
        && isValidId(tenderId)
        && incoming().createdBy == request.auth.uid
        && incoming().title is string && incoming().title.size() > 0
        && incoming().category is string
        && (incoming().status in ['DRAFT', 'PUBLISHED', 'LIVE'])
        && (
          (incoming().status == 'DRAFT' && (!('closingDate' in incoming()) || incoming().closingDate == null || incoming().closingDate is timestamp))
          ||
          (incoming().status in ['PUBLISHED', 'LIVE'] && incoming().closingDate is timestamp)
        );

      // Update tender:
      // Restricted strictly to authorized government personnel.
      // Prevents arbitrary jumps (e.g. DRAFT straight to AWARDED is strictly denied).
      // If updating a DRAFT, allow field edits within legal draft transitions: DRAFT may omit closingDate, while transition to PUBLISHED/LIVE requires a valid Timestamp closingDate.
      // If updating a non-DRAFT tender, prevent modifications to fundamental procurement specs and closingDate.
      allow update: if isGovernmentUser()
        && isValidId(tenderId)
        && incoming().createdBy == existing().createdBy
        && incoming().tenderNumber == existing().tenderNumber
        && isValidStatusTransition(existing().status, incoming().status)
        && (
          // Case 1: Editing a DRAFT tender (must remain DRAFT or legal first transition)
          (
            existing().status == 'DRAFT'
            && incoming().status in ['DRAFT', 'PUBLISHED', 'LIVE', 'CANCELLED']
            && (
              (incoming().status in ['PUBLISHED', 'LIVE'] && incoming().closingDate is timestamp)
              ||
              (incoming().status in ['DRAFT', 'CANCELLED'] && (!('closingDate' in incoming()) || incoming().closingDate == null || incoming().closingDate is timestamp))
            )
          )
          ||
          // Case 2: Controlled lifecycle transitions for PUBLISHED/LIVE/CLOSED tenders
          (
            existing().status != 'DRAFT'
            && incoming().category == existing().category
            && incoming().closingDate == existing().closingDate
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'publishedAt', 'closedAt', 'updatedAt', 'proposalsCount', 'anomaliesCount', 'riskScore', 'riskLevel', 'specialRequirements'
            ])
          )
        );

      // Tenders cannot be deleted directly from client; state transition to CANCELLED or ARCHIVED is enforced
      allow delete: if false;
    }

    // 6. Tender Audit Events Collection Rules (/tenderEvents/{eventId})
    match /tenderEvents/{eventId} {
      // Reading tender events is permitted for authenticated government users
      allow get, list: if isGovernmentUser() && isValidId(eventId);

      // Helper to validate that action matches legal state transitions according to BTI lifecycle engine
      function isValidTenderAuditEvent(event) {
        return (
          // CREATED: initial creation event; previousStatus absent or null; newStatus DRAFT or LIVE/PUBLISHED
          (event.action == 'CREATED' &&
           (!('previousStatus' in event) || event.previousStatus == null) &&
           (event.newStatus in ['DRAFT', 'PUBLISHED', 'LIVE'])) ||

          // UPDATED: allowed draft update operation; status must remain DRAFT
          (event.action == 'UPDATED' &&
           ('previousStatus' in event) && event.previousStatus == 'DRAFT' &&
           event.newStatus == 'DRAFT') ||

          // PUBLISHED: transition from DRAFT to LIVE or PUBLISHED
          (event.action == 'PUBLISHED' &&
           ('previousStatus' in event) && event.previousStatus == 'DRAFT' &&
           (event.newStatus in ['PUBLISHED', 'LIVE'])) ||

          // CLOSED: transition from active state (LIVE, PUBLISHED, Open) to CLOSED
          (event.action == 'CLOSED' &&
           ('previousStatus' in event) && (event.previousStatus in ['PUBLISHED', 'LIVE', 'Open']) &&
           event.newStatus == 'CLOSED') ||

          // CANCELLED: transition from valid cancellable state to CANCELLED
          (event.action == 'CANCELLED' &&
           ('previousStatus' in event) && (event.previousStatus in ['DRAFT', 'PUBLISHED', 'LIVE', 'Open', 'UNDER_EVALUATION']) &&
           event.newStatus == 'CANCELLED') ||

          // ARCHIVED: transition from valid archivable state to ARCHIVED
          (event.action == 'ARCHIVED' &&
           ('previousStatus' in event) && (event.previousStatus in ['CLOSED', 'AWARDED', 'CANCELLED']) &&
           event.newStatus == 'ARCHIVED')
        );
      }

      // Creation of tender audit events:
      // - Must be authenticated government user matching request.auth.uid
      // - Event ID must match document ID
      // - Action must be in canonical action set
      // - Status values must be valid and conform to lifecycle transition rules
      // - Consistency validation against authoritative tender document:
      //   * The tender must exist after the atomic batch commit
      //   * The event's newStatus must strictly match the tender's status after commit
      //   * For initial CREATED event: tender must not have existed prior to batch
      //   * For transitions (UPDATED, PUBLISHED, etc.): tender must have existed prior to batch
      //     and its previous state must match previousStatus
      allow create: if isGovernmentUser()
        && isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().actorId == request.auth.uid
        && incoming().actorRole == 'government'
        && incoming().action in ['CREATED', 'UPDATED', 'PUBLISHED', 'CLOSED', 'CANCELLED', 'ARCHIVED']
        && (incoming().tenderId is string && isValidId(incoming().tenderId))
        && (incoming().timestamp is string && incoming().timestamp.size() > 0)
        && (incoming().newStatus in ['DRAFT', 'PUBLISHED', 'LIVE', 'CLOSED', 'UNDER_EVALUATION', 'AWARDED', 'CANCELLED', 'ARCHIVED'])
        && isValidTenderAuditEvent(incoming())
        && existsAfter(/databases/$(database)/documents/tenders/$(incoming().tenderId))
        && getAfter(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.status == incoming().newStatus
        && (
          // Case 1: Initial creation event
          (
            incoming().action == 'CREATED'
            && !exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
          )
          ||
          // Case 2: State transition event on an existing tender
          (
            incoming().action != 'CREATED'
            && exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
            && get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.status == incoming().previousStatus
            && isValidStatusTransition(incoming().previousStatus, incoming().newStatus)
          )
        );

      // Tender audit events are strictly append-only and immutable
      allow update, delete: if false;
    }

    // 6. Proposals Collection Rules (/proposals/{proposalId})
    match /proposals/{proposalId} {
      // Read allowed for government users or agency belonging to the proposal's organization or submitter
      allow get: if isSignedIn() && (
        isGovernmentUser() ||
        (isAgencyUser() && (
          resource.data.organizationId == getUserOrgId() ||
          resource.data.submittedBy == request.auth.uid
        ))
      );

      // List allowed:
      // Government users can query proposals across tenders.
      // Agency users can query proposals for their organization or their own UID.
      allow list: if isSignedIn() && (
        isGovernmentUser() ||
        (isAgencyUser() && (
          resource.data.organizationId == getUserOrgId() ||
          resource.data.submittedBy == request.auth.uid
        ))
      );

      // Create: Only verified agency can create a DRAFT proposal for a LIVE non-expired tender
      allow create: if isSignedIn()
        && isAgencyUser()
        && isVerifiedAgency()
        && isValidId(proposalId)
        && incoming().id == proposalId
        && incoming().submittedBy == request.auth.uid
        && incoming().status == 'DRAFT'
        && incoming().tenderId is string
        && exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
        && get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.status in ['PUBLISHED', 'LIVE', 'Open']
        && (
          !('closingDate' in get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data) ||
          get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.closingDate > request.time
        );

      // Update:
      // Case 1: Agency updating own DRAFT (or submitting DRAFT -> SUBMITTED before deadline)
      // Case 2: Agency withdrawing SUBMITTED -> WITHDRAWN
      // Case 3: Government reviewing proposal (changing status, reviewer notes, without altering agency proposal content)
      allow update: if isSignedIn() && (
        // Case 1: Agency editing DRAFT
        (
          isAgencyUser()
          && (existing().organizationId == getUserOrgId() || existing().submittedBy == request.auth.uid)
          && existing().status == 'DRAFT'
          && (
            // Subcase 1a: Keeping as DRAFT
            (incoming().status == 'DRAFT')
            ||
            // Subcase 1b: Submitting proposal before deadline on a LIVE tender
            (
              incoming().status == 'SUBMITTED'
              && exists(/databases/$(database)/documents/tenders/$(existing().tenderId))
              && get(/databases/$(database)/documents/tenders/$(existing().tenderId)).data.status in ['PUBLISHED', 'LIVE', 'Open']
              && (
                !('closingDate' in get(/databases/$(database)/documents/tenders/$(existing().tenderId)).data) ||
                get(/databases/$(database)/documents/tenders/$(existing().tenderId)).data.closingDate > request.time
              )
            )
          )
        )
        ||
        // Case 2: Agency withdrawing SUBMITTED proposal
        (
          isAgencyUser()
          && (existing().organizationId == getUserOrgId() || existing().submittedBy == request.auth.uid)
          && existing().status == 'SUBMITTED'
          && incoming().status == 'WITHDRAWN'
        )
        ||
        // Case 3: Government user updating review status and notes without mutating agency content
        (
          isGovernmentUser()
          && isValidProposalStatusTransition(existing().status, incoming().status)
          && (!('technicalProposal' in existing()) || incoming().technicalProposal == existing().technicalProposal)
          && (!('financialProposal' in existing()) || incoming().financialProposal == existing().financialProposal)
          && (!('implementationPlan' in existing()) || incoming().implementationPlan == existing().implementationPlan)
        )
      );

      // Proposals are permanent records, deletion forbidden
      allow delete: if false;
    }

    // 7. Proposal Audit Events Collection Rules (/proposalEvents/{eventId})
    match /proposalEvents/{eventId} {
      // Read allowed for government users or agency belonging to the organization or actor
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isAgencyUser() && (
          resource.data.organizationId == getUserOrgId() ||
          resource.data.actorId == request.auth.uid
        ))
      );

      // Append-only creation of proposal audit events
      allow create: if isSignedIn()
        && isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().actorId == request.auth.uid
        && incoming().action in ['CREATED', 'UPDATED', 'SUBMITTED', 'WITHDRAWN', 'UNDER_REVIEW', 'SHORTLISTED', 'REJECTED', 'AWARDED']
        && existsAfter(/databases/$(database)/documents/proposals/$(incoming().proposalId));

      // Audit events are strictly immutable
      allow update, delete: if false;
    }
  }
}

