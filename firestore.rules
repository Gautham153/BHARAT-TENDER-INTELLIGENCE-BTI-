rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isGovernmentUser() {
      return isSignedIn() && (
        (request.auth.token.role in ['government', 'government_admin', 'government_officer']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['government', 'government_admin', 'government_officer'])
      );
    }

    function isAgencyUser() {
      return isSignedIn() && (
        (request.auth.token.role == 'agency') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agency')
      );
    }

    function isVerifiedAgency() {
      return isAgencyUser() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified'
      );
    }

    function getUserOrgId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId
        : '';
    }

    // Authoritative Government proposal review transition validator:
    // Strictly enforces legal unidirectional evaluation transitions. Prevents same-status mutations and prevents modifying DRAFTs.
    function isValidGovernmentProposalTransition(prev, next) {
      return (prev == 'SUBMITTED' && next == 'UNDER_REVIEW')
        || (prev == 'UNDER_REVIEW' && (next in ['SHORTLISTED', 'REJECTED']))
        || (prev == 'SHORTLISTED' && (next in ['AWARDED', 'REJECTED']));
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.role in ['government', 'agency', 'public']
        && data.verificationStatus in ['not_started', 'pending', 'verified', 'failed', 'requires_review'];
    }

    // Authoritative tender status transition validator
    // Enforces strict unidirectional and legal state transitions:
    // DRAFT -> PUBLISHED/LIVE -> CLOSED -> UNDER_EVALUATION -> AWARDED -> ARCHIVED (with legal cancellation paths)
    function isValidStatusTransition(prev, next) {
      return prev == next
        || (prev == 'DRAFT' && (next in ['DRAFT', 'PUBLISHED', 'LIVE', 'CANCELLED']))
        || (prev in ['PUBLISHED', 'LIVE', 'Open'] && (next in ['LIVE', 'CLOSED', 'CANCELLED']))
        || (prev == 'CLOSED' && (next in ['UNDER_EVALUATION', 'ARCHIVED']))
        || (prev == 'UNDER_EVALUATION' && (next in ['AWARDED', 'CANCELLED']))
        || (prev == 'AWARDED' && (next == 'ARCHIVED'))
        || (prev == 'CANCELLED' && (next == 'ARCHIVED'));
    }

    // Authoritative project lifecycle status transition validator:
    // NOT_STARTED -> IN_PROGRESS -> ON_HOLD -> COMPLETED -> CLOSED
    function isValidProjectStatusTransition(prev, next) {
      return prev == next
        || (prev == 'NOT_STARTED' && (next in ['IN_PROGRESS', 'ON_HOLD']))
        || (prev == 'IN_PROGRESS' && (next in ['ON_HOLD', 'COMPLETED']))
        || (prev == 'ON_HOLD' && (next in ['IN_PROGRESS', 'CLOSED']))
        || (prev == 'COMPLETED' && (next == 'CLOSED'));
    }

    // Audit-event document ID helper functions
    function projectCreatedAuditId(projectId) {
      return 'evt-proj-create-' + projectId;
    }

    function projectStatusAuditId(eventId) {
      return eventId;
    }

    function milestoneCreatedAuditId(milestoneId) {
      return 'evt-ms-create-' + milestoneId;
    }

    function progressSubmittedAuditId(updateId) {
      return 'evt-prog-submit-' + updateId;
    }

    function financialSubmittedAuditId(recordId) {
      return 'evt-fin-submit-' + recordId;
    }

    function financialVerifiedAuditId(recordId) {
      return 'evt-fin-verify-' + recordId;
    }

    function inspectionCreatedAuditId(inspectionId) {
      return 'evt-insp-create-' + inspectionId;
    }

    function exceptionDetectedAuditId(exceptionId) {
      return 'evt-exc-detect-' + exceptionId;
    }

    function exceptionAcknowledgedAuditId(exceptionId) {
      return 'evt-exc-ack-' + exceptionId;
    }

    function exceptionResolvedAuditId(exceptionId) {
      return 'evt-exc-resolve-' + exceptionId;
    }

    // 2. Users Collection Rules (/users/{uid})
    match /users/{uid} {
      // Individual document read allowed for the account owner or verified government personnel
      allow get: if isSignedIn() && isValidId(uid) && (
        request.auth.uid == uid || isGovernmentUser()
      );

      // Query listings strictly restricted to user's own record
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Registration: User can create their profile only for themselves with role 'agency' and status 'pending'
      // Preventing privilege escalation: self-assigned 'government' role or pre-verified status is forbidden.
      allow create: if isSignedIn() 
        && isValidId(uid) 
        && request.auth.uid == uid
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'agency'
        && incoming().verificationStatus == 'pending'
        && incoming().verified == false;

      // Updates: Account owner can update non-privileged profile information
      allow update: if isSignedIn()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().verificationStatus == existing().verificationStatus
        && incoming().verified == existing().verified
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'phone', 'designation', 'organizationName', 'address', 'businessCategory', 'updatedAt'
        ]);

      // Updates by Government Nodal Reviewer (can update verification status and verified flag during adjudication)
      allow update: if isGovernmentUser()
        && isValidId(uid)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'verified', 'verificationStatus', 'updatedAt'
        ]);

      // Direct document deletion forbidden from client
      allow delete: if false;
    }

    // 3. Organizations Collection Rules (/organizations/{organizationId})
    match /organizations/{organizationId} {
      // Read allowed for the primary organization user or verified government personnel
      allow get: if isSignedIn() && isValidId(organizationId) && (
        resource == null || resource.data.primaryUserId == request.auth.uid || isGovernmentUser()
      );

      // List allowed for primary user or government reviewers
      allow list: if isSignedIn() && (
        resource.data.primaryUserId == request.auth.uid || isGovernmentUser()
      );

      // Create: Agency user only can create organization record for their own UID.
      // Requires authenticated agency profile in /users/{uid} and unverified initial state.
      allow create: if isSignedIn()
        && isValidId(organizationId)
        && incoming().primaryUserId == request.auth.uid
        && isAgencyUser()
        && incoming().gstin is string && incoming().gstin.size() == 15
        && (incoming().verificationStatus in ['pending', 'not_started'])
        && incoming().verified == false;

      // Update by Government Nodal Reviewer (restricted strictly to adjudication state fields)
      allow update: if isGovernmentUser()
        && isValidId(organizationId)
        && incoming().organizationId == existing().organizationId
        && incoming().gstin == existing().gstin
        && incoming().primaryUserId == existing().primaryUserId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'verificationStatus', 'btiAuthorizationStatus', 'verified', 'verificationCompletedAt', 'rejectionReason', 'reviewNotes', 'updatedAt'
        ]);

      // Update by Agency Owner (cannot tamper with verification status or GSTIN)
      allow update: if isSignedIn()
        && isValidId(organizationId)
        && request.auth.uid == existing().primaryUserId
        && incoming().organizationId == existing().organizationId
        && incoming().gstin == existing().gstin
        && incoming().primaryUserId == existing().primaryUserId
        && incoming().verificationStatus == existing().verificationStatus
        && incoming().verified == existing().verified
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'registeredAddress', 'contactEmail', 'contactPhone', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // 4. Verification Events Audit Log (/verificationEvents/{eventId})
    // Audit records are strictly append-only (no updates, no deletions)
    match /verificationEvents/{eventId} {
      // Agency users may read events only for organizations they own
      function isOrgOwnerForEvent() {
        return isAgencyUser()
          && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId))
          && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.primaryUserId == request.auth.uid;
      }

      // Read single event: authorized government reviewer or agency owner of the organization
      allow get: if isSignedIn() && isValidId(eventId) && (
        isGovernmentUser() || isOrgOwnerForEvent()
      );

      // List audit events: authorized government reviewer or agency owner of the organization
      allow list: if isSignedIn() && (
        isGovernmentUser() || isOrgOwnerForEvent()
      );

      // Agency audit action validation: only owner agency can create SUBMITTED or RETRY_REQUESTED events for their own org
      function isAgencyEventValid() {
        return isAgencyUser()
          && incoming().actorId == request.auth.uid
          && incoming().actorRole == 'agency'
          && incoming().action in ['SUBMITTED', 'RETRY_REQUESTED']
          && exists(/databases/$(database)/documents/organizations/$(incoming().organizationId))
          && get(/databases/$(database)/documents/organizations/$(incoming().organizationId)).data.primaryUserId == request.auth.uid;
      }

      // Government nodal review audit action validation: government reviewers can record review/adjudication events
      function isGovEventValid() {
        return isGovernmentUser()
          && incoming().actorId == request.auth.uid
          && incoming().actorRole == 'government'
          && incoming().action in ['MARKED_FOR_REVIEW', 'APPROVED', 'REJECTED']
          && exists(/databases/$(database)/documents/organizations/$(incoming().organizationId));
      }

      // Append new audit event - strictly enforced by actor role authorization matrix & ownership
      allow create: if isSignedIn()
        && isValidId(eventId)
        && (isAgencyEventValid() || isGovEventValid());

      // Audit logs are strictly immutable
      allow update, delete: if false;
    }

    // 5. Tenders Collection Rules (/tenders/{tenderId})
    match /tenders/{tenderId} {
      // Helper to check active published status and non-expired deadline for agency discovery & detail access.
      // Agency users are strictly restricted to active LIVE tenders whose closing deadline is strictly in the future.
      // DRAFT, CLOSED, UNDER_EVALUATION, AWARDED, CANCELLED, ARCHIVED, or tenders where closingDate <= request.time are forbidden.
      function isActiveAndNotExpired(data) {
        return (data.status in ['PUBLISHED', 'LIVE', 'Open'])
          && (data.closingDate is timestamp)
          && (data.closingDate > request.time);
      }

      // Read single tender:
      // Government users retain full lifecycle visibility across all statuses (including DRAFT, CLOSED, ARCHIVED, and expired).
      // Authenticated agency users can only read active LIVE procurement notices whose deadline has not elapsed.
      allow get: if isSignedIn() && isValidId(tenderId) && (
        isGovernmentUser() || (isAgencyUser() && isActiveAndNotExpired(resource.data))
      );

      // List tenders:
      // Government users can list all tenders across full lifecycle.
      // Authenticated agency users can query active published procurement notices deterministically.
      allow list: if isSignedIn() && (
        isGovernmentUser() || (isAgencyUser() && resource.data.status in ['PUBLISHED', 'LIVE', 'Open'])
      );

      // Create tender:
      // Restricted strictly to authenticated government personnel.
      // Must set createdBy to the user's UID and status to DRAFT or PUBLISHED/LIVE.
      // DRAFT may omit closingDate; PUBLISHED/LIVE tenders must persist closingDate as a valid Firestore Timestamp.
      allow create: if isGovernmentUser()
        && isValidId(tenderId)
        && incoming().createdBy == request.auth.uid
        && incoming().title is string && incoming().title.size() > 0
        && incoming().category is string
        && (incoming().status in ['DRAFT', 'PUBLISHED', 'LIVE'])
        && (
          (incoming().status == 'DRAFT' && (!('closingDate' in incoming()) || incoming().closingDate == null || incoming().closingDate is timestamp))
          ||
          (incoming().status in ['PUBLISHED', 'LIVE'] && incoming().closingDate is timestamp)
        );

      // Update tender:
      // Restricted strictly to authorized government personnel.
      // Prevents arbitrary jumps (e.g. DRAFT straight to AWARDED is strictly denied).
      // If updating a DRAFT, allow field edits within legal draft transitions: DRAFT may omit closingDate, while transition to PUBLISHED/LIVE requires a valid Timestamp closingDate.
      // If updating a non-DRAFT tender, prevent modifications to fundamental procurement specs and closingDate.
      allow update: if isGovernmentUser()
        && isValidId(tenderId)
        && incoming().createdBy == existing().createdBy
        && incoming().tenderNumber == existing().tenderNumber
        && isValidStatusTransition(existing().status, incoming().status)
        && (
          // Case 1: Editing a DRAFT tender (must remain DRAFT or legal first transition)
          (
            existing().status == 'DRAFT'
            && incoming().status in ['DRAFT', 'PUBLISHED', 'LIVE', 'CANCELLED']
            && (
              (incoming().status in ['PUBLISHED', 'LIVE'] && incoming().closingDate is timestamp)
              ||
              (incoming().status in ['DRAFT', 'CANCELLED'] && (!('closingDate' in incoming()) || incoming().closingDate == null || incoming().closingDate is timestamp))
            )
          )
          ||
          // Case 2: Controlled lifecycle transitions for PUBLISHED/LIVE/CLOSED tenders
          (
            existing().status != 'DRAFT'
            && incoming().category == existing().category
            && incoming().closingDate == existing().closingDate
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'publishedAt', 'closedAt', 'updatedAt', 'proposalsCount', 'anomaliesCount', 'riskScore', 'riskLevel', 'specialRequirements'
            ])
          )
        );

      // Tenders cannot be deleted directly from client; state transition to CANCELLED or ARCHIVED is enforced
      allow delete: if false;
    }

    // 6. Tender Audit Events Collection Rules (/tenderEvents/{eventId})
    match /tenderEvents/{eventId} {
      // Reading tender events is permitted for authenticated government users
      allow get, list: if isGovernmentUser() && isValidId(eventId);

      // Helper to validate that action matches legal state transitions according to BTI lifecycle engine
      function isValidTenderAuditEvent(event) {
        return (
          // CREATED: initial creation event; previousStatus absent or null; newStatus DRAFT or LIVE/PUBLISHED
          (event.action == 'CREATED' &&
           (!('previousStatus' in event) || event.previousStatus == null) &&
           (event.newStatus in ['DRAFT', 'PUBLISHED', 'LIVE'])) ||

          // UPDATED: allowed draft update operation; status must remain DRAFT
          (event.action == 'UPDATED' &&
           ('previousStatus' in event) && event.previousStatus == 'DRAFT' &&
           event.newStatus == 'DRAFT') ||

          // PUBLISHED: transition from DRAFT to LIVE or PUBLISHED
          (event.action == 'PUBLISHED' &&
           ('previousStatus' in event) && event.previousStatus == 'DRAFT' &&
           (event.newStatus in ['PUBLISHED', 'LIVE'])) ||

          // CLOSED: transition from active state (LIVE, PUBLISHED, Open) to CLOSED
          (event.action == 'CLOSED' &&
           ('previousStatus' in event) && (event.previousStatus in ['PUBLISHED', 'LIVE', 'Open']) &&
           event.newStatus == 'CLOSED') ||

          // CANCELLED: transition from valid cancellable state to CANCELLED
          (event.action == 'CANCELLED' &&
           ('previousStatus' in event) && (event.previousStatus in ['DRAFT', 'PUBLISHED', 'LIVE', 'Open', 'UNDER_EVALUATION']) &&
           event.newStatus == 'CANCELLED') ||

          // ARCHIVED: transition from valid archivable state to ARCHIVED
          (event.action == 'ARCHIVED' &&
           ('previousStatus' in event) && (event.previousStatus in ['CLOSED', 'AWARDED', 'CANCELLED']) &&
           event.newStatus == 'ARCHIVED')
        );
      }

      // Creation of tender audit events:
      // - Must be authenticated government user matching request.auth.uid
      // - Event ID must match document ID
      // - Action must be in canonical action set
      // - Status values must be valid and conform to lifecycle transition rules
      // - Consistency validation against authoritative tender document:
      //   * The tender must exist after the atomic batch commit
      //   * The event's newStatus must strictly match the tender's status after commit
      //   * For initial CREATED event: tender must not have existed prior to batch
      //   * For transitions (UPDATED, PUBLISHED, etc.): tender must have existed prior to batch
      //     and its previous state must match previousStatus
      allow create: if isGovernmentUser()
        && isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().actorId == request.auth.uid
        && incoming().actorRole == 'government'
        && incoming().action in ['CREATED', 'UPDATED', 'PUBLISHED', 'CLOSED', 'CANCELLED', 'ARCHIVED']
        && (incoming().tenderId is string && isValidId(incoming().tenderId))
        && (incoming().timestamp is string && incoming().timestamp.size() > 0)
        && (incoming().newStatus in ['DRAFT', 'PUBLISHED', 'LIVE', 'CLOSED', 'UNDER_EVALUATION', 'AWARDED', 'CANCELLED', 'ARCHIVED'])
        && isValidTenderAuditEvent(incoming())
        && getAfter(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.status == incoming().newStatus
        && (
          // Case 1: Initial creation event
          (
            incoming().action == 'CREATED'
            && !exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
          )
          ||
          // Case 2: State transition event on an existing tender
          (
            incoming().action != 'CREATED'
            && exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
            && get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.status == incoming().previousStatus
            && isValidStatusTransition(incoming().previousStatus, incoming().newStatus)
          )
        );

      // Tender audit events are strictly append-only and immutable
      allow update, delete: if false;
    }

    // 6. Proposals Collection Rules (/proposals/{proposalId})
    match /proposals/{proposalId} {
      // Read allowed for government users or agency belonging to the proposal's organization or submitter
      allow get: if isSignedIn() && (
        isGovernmentUser() ||
        (isAgencyUser() && (
          resource.data.organizationId == getUserOrgId() ||
          resource.data.submittedBy == request.auth.uid
        ))
      );

      // List allowed:
      // Government users can query proposals across tenders.
      // Agency users can query proposals for their organization or their own UID.
      allow list: if isSignedIn() && (
        isGovernmentUser() ||
        (isAgencyUser() && (
          resource.data.organizationId == getUserOrgId() ||
          resource.data.submittedBy == request.auth.uid
        ))
      );

      // Create: Only verified agency can create a DRAFT proposal for a LIVE non-expired tender
      allow create: if isSignedIn()
        && isAgencyUser()
        && isVerifiedAgency()
        && isValidId(proposalId)
        && incoming().id == proposalId
        && incoming().submittedBy == request.auth.uid
        && incoming().organizationId == getUserOrgId()
        && incoming().status == 'DRAFT'
        && incoming().tenderId is string
        && exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
        && get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.status in ['PUBLISHED', 'LIVE', 'Open']
        && (
          !('closingDate' in get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data) ||
          get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data.closingDate > request.time
        );

      // Update:
      // Case 1: Agency editing DRAFT content (proposal remains DRAFT, immutable identity/ownership/tender fields protected)
      // Case 2: Agency submitting DRAFT -> SUBMITTED before deadline on a LIVE tender (locks submission, preserves immutable identity)
      // Case 3: Agency withdrawing SUBMITTED -> WITHDRAWN
      // Case 4: Government review transitions (may change only review/adjudication fields, all agency proposal content locked)
      allow update: if isSignedIn() && (
        // Case 1: Agency editing DRAFT content
        (
          isAgencyUser()
          && (existing().organizationId == getUserOrgId() || existing().submittedBy == request.auth.uid)
          && existing().status == 'DRAFT'
          && incoming().status == 'DRAFT'
          && incoming().submittedBy == existing().submittedBy
          && incoming().organizationId == existing().organizationId
          && incoming().tenderId == existing().tenderId
          && incoming().get('id', '') == existing().get('id', '')
          && incoming().get('proposalNumber', '') == existing().get('proposalNumber', '')
          && incoming().get('tenderNumber', '') == existing().get('tenderNumber', '')
          && incoming().get('tenderTitle', '') == existing().get('tenderTitle', '')
          && incoming().get('organizationName', '') == existing().get('organizationName', '')
          && incoming().get('organizationGstin', '') == existing().get('organizationGstin', '')
          && incoming().get('submittedByName', '') == existing().get('submittedByName', '')
          && incoming().get('submittedByEmail', '') == existing().get('submittedByEmail', '')
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'technicalProposal',
            'implementationPlan',
            'financialProposal',
            'timeline',
            'experience',
            'complianceDeclarations',
            'supportingDocuments',
            'updatedAt'
          ])
        )
        ||
        // Case 2: Agency submitting DRAFT -> SUBMITTED before deadline on a LIVE tender
        (
          isAgencyUser()
          && isVerifiedAgency()
          && (existing().organizationId == getUserOrgId() || existing().submittedBy == request.auth.uid)
          && existing().status == 'DRAFT'
          && incoming().status == 'SUBMITTED'
          && incoming().submittedBy == existing().submittedBy
          && incoming().organizationId == existing().organizationId
          && incoming().tenderId == existing().tenderId
          && incoming().get('id', '') == existing().get('id', '')
          && incoming().get('proposalNumber', '') == existing().get('proposalNumber', '')
          && incoming().get('tenderNumber', '') == existing().get('tenderNumber', '')
          && incoming().get('tenderTitle', '') == existing().get('tenderTitle', '')
          && incoming().get('organizationName', '') == existing().get('organizationName', '')
          && incoming().get('organizationGstin', '') == existing().get('organizationGstin', '')
          && incoming().get('submittedByName', '') == existing().get('submittedByName', '')
          && incoming().get('submittedByEmail', '') == existing().get('submittedByEmail', '')
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && exists(/databases/$(database)/documents/tenders/$(existing().tenderId))
          && get(/databases/$(database)/documents/tenders/$(existing().tenderId)).data.status in ['PUBLISHED', 'LIVE', 'Open']
          && (
            !('closingDate' in get(/databases/$(database)/documents/tenders/$(existing().tenderId)).data) ||
            get(/databases/$(database)/documents/tenders/$(existing().tenderId)).data.closingDate > request.time
          )
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'submittedAt',
            'updatedAt',
            'financialBidAmount',
            'quotedAmount',
            'submissionDate',
            'complianceDeclarations',
            'technicalProposal',
            'implementationPlan',
            'financialProposal',
            'timeline',
            'experience',
            'supportingDocuments'
          ])
        )
        ||
        // Case 3: Agency withdrawing SUBMITTED proposal
        (
          isAgencyUser()
          && (existing().organizationId == getUserOrgId() || existing().submittedBy == request.auth.uid)
          && existing().status == 'SUBMITTED'
          && incoming().status == 'WITHDRAWN'
          && incoming().submittedBy == existing().submittedBy
          && incoming().organizationId == existing().organizationId
          && incoming().tenderId == existing().tenderId
          && incoming().get('id', '') == existing().get('id', '')
          && incoming().get('proposalNumber', '') == existing().get('proposalNumber', '')
          && incoming().get('tenderNumber', '') == existing().get('tenderNumber', '')
          && incoming().get('tenderTitle', '') == existing().get('tenderTitle', '')
          && incoming().get('organizationName', '') == existing().get('organizationName', '')
          && incoming().get('organizationGstin', '') == existing().get('organizationGstin', '')
          && incoming().get('submittedByName', '') == existing().get('submittedByName', '')
          && incoming().get('submittedByEmail', '') == existing().get('submittedByEmail', '')
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'withdrawnAt',
            'withdrawalReason'
          ])
        )
        ||
        // Case 4: Government review transitions (Government may change only review/adjudication fields on SUBMITTED, UNDER_REVIEW, SHORTLISTED)
        (
          isGovernmentUser()
          && existing().status in ['SUBMITTED', 'UNDER_REVIEW', 'SHORTLISTED']
          && isValidGovernmentProposalTransition(existing().status, incoming().status)
          && incoming().submittedBy == existing().submittedBy
          && incoming().organizationId == existing().organizationId
          && incoming().tenderId == existing().tenderId
          && incoming().get('id', '') == existing().get('id', '')
          && incoming().get('proposalNumber', '') == existing().get('proposalNumber', '')
          && incoming().get('tenderNumber', '') == existing().get('tenderNumber', '')
          && incoming().get('tenderTitle', '') == existing().get('tenderTitle', '')
          && incoming().get('organizationName', '') == existing().get('organizationName', '')
          && incoming().get('organizationGstin', '') == existing().get('organizationGstin', '')
          && incoming().get('submittedByName', '') == existing().get('submittedByName', '')
          && incoming().get('submittedByEmail', '') == existing().get('submittedByEmail', '')
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'reviewStatus',
            'reviewerNotes',
            'reviewedBy',
            'reviewedByName',
            'reviewedAt'
          ])
        )
      );

      // Proposals are permanent records, deletion forbidden
      allow delete: if false;
    }

    // 7. Proposal Audit Events Collection Rules (/proposalEvents/{eventId})
    match /proposalEvents/{eventId} {
      // Read allowed for government users or agency belonging to the organization or actor
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isAgencyUser() && (
          resource.data.organizationId == getUserOrgId() ||
          resource.data.actorId == request.auth.uid
        ))
      );

      // Append-only creation of proposal audit events strictly bound to authoritative proposal state
      allow create: if isSignedIn()
        && isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().actorId == request.auth.uid
        && incoming().proposalId is string
        && incoming().tenderId == getAfter(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.tenderId
        && incoming().organizationId == getAfter(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.organizationId
        && incoming().newStatus == getAfter(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status
        && (
          // Case 1: Agency actions (CREATED, UPDATED, SUBMITTED, WITHDRAWN)
          (
            isAgencyUser()
            && incoming().actorRole == 'agency'
            && incoming().organizationId == getUserOrgId()
            && incoming().action in ['CREATED', 'UPDATED', 'SUBMITTED', 'WITHDRAWN']
            && (
              (
                incoming().action == 'CREATED'
                && incoming().newStatus == 'DRAFT'
                && !exists(/databases/$(database)/documents/proposals/$(incoming().proposalId))
              )
              ||
              (
                incoming().action == 'UPDATED'
                && exists(/databases/$(database)/documents/proposals/$(incoming().proposalId))
                && incoming().get('previousStatus', '') == 'DRAFT'
                && incoming().newStatus == 'DRAFT'
                && get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status == 'DRAFT'
                && getAfter(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status == 'DRAFT'
                && getAfter(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.updatedAt != get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.updatedAt
              )
              ||
              (
                incoming().action in ['SUBMITTED', 'WITHDRAWN']
                && exists(/databases/$(database)/documents/proposals/$(incoming().proposalId))
                && incoming().get('previousStatus', '') == get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status
              )
            )
          )
          ||
          // Case 2: Government adjudication review actions
          (
            isGovernmentUser()
            && incoming().actorRole == 'government'
            && incoming().action in ['UNDER_REVIEW', 'SHORTLISTED', 'REJECTED', 'AWARDED']
            && exists(/databases/$(database)/documents/proposals/$(incoming().proposalId))
            && incoming().get('previousStatus', '') == get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status
            && isValidGovernmentProposalTransition(get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status, incoming().newStatus)
          )
        );

      // Audit events are strictly immutable
      allow update, delete: if false;
    }

    // 8. Proposal Evaluations Collection Rules (/proposalEvaluations/{evaluationId})
    // Phase 5: Authoritative AI evaluations accessible strictly by authorized government reviewers
    match /proposalEvaluations/{evaluationId} {
      // Read allowed strictly for government personnel (agencies and public are forbidden)
      allow get, list: if isSignedIn() && isGovernmentUser();

      // Evaluations are created exclusively by the trusted server-side evaluation service
      // Direct client creation, modification, and deletion are strictly forbidden
      allow create, update, delete: if false;
    }

    // 9. Projects Collection Rules (/projects/{projectId})
    // Phase 6: Authoritative implementation monitoring records
    match /projects/{projectId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && resource.data.organizationId == getUserOrgId())
      );

      allow create: if isSignedIn() && isGovernmentUser() && isValidId(projectId)
        && incoming().id == projectId
        && incoming().authorityId == request.auth.uid
        && projectId == ('proj-' + incoming().proposalId)
        && incoming().sanctionedAmount is number
        && incoming().awardedAmount is number
        && incoming().sanctionedAmount > 0
        && incoming().awardedAmount > 0
        && incoming().status == 'NOT_STARTED'
        && incoming().physicalProgressPercent == 0
        && incoming().physicalProgress == 0
        && incoming().financialProgressPercent == 0
        && incoming().financialProgress == 0
        && incoming().utilizedAmount == 0
        && (!incoming().keys().hasAny(['amountDisbursed']) || incoming().amountDisbursed == 0)
        && (!incoming().keys().hasAny(['disbursedAmount']) || incoming().disbursedAmount == 0)
        && incoming().proposalId is string && isValidId(incoming().proposalId)
        && incoming().tenderId is string && isValidId(incoming().tenderId)
        && incoming().organizationId is string && isValidId(incoming().organizationId)
        && exists(/databases/$(database)/documents/proposals/$(incoming().proposalId))
        && get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.status == 'AWARDED'
        && get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.tenderId == incoming().tenderId
        && get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data.organizationId == incoming().organizationId
        && exists(/databases/$(database)/documents/tenders/$(incoming().tenderId))
        && isValidProjectFinancialBaseline()
        && exists(/databases/$(database)/documents/organizations/$(incoming().organizationId))
        && (
          get(/databases/$(database)/documents/organizations/$(incoming().organizationId)).data.verified == true ||
          get(/databases/$(database)/documents/organizations/$(incoming().organizationId)).data.verificationStatus == 'verified'
        )
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(projectCreatedAuditId(projectId))).data.action == 'PROJECT_CREATED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(projectCreatedAuditId(projectId))).data.projectId == projectId;

      // Project Financial Baseline and Progress Verification Helper Functions
      function isValidProjectFinancialBaseline() {
        let tenderDoc = get(/databases/$(database)/documents/tenders/$(incoming().tenderId)).data;
        let propDoc = get(/databases/$(database)/documents/proposals/$(incoming().proposalId)).data;
        let expectedSanctioned = tenderDoc.get('sanctionedAmount', tenderDoc.get('estimatedCost', tenderDoc.get('budget', 0)));
        let hasFinMap = ('financialProposal' in propDoc) && (propDoc.financialProposal is map);
        let finProp = hasFinMap ? propDoc.financialProposal : {};
        let totalProposed = finProp.get('totalProposedAmount', 0);
        let baseProposed = finProp.get('baseAmount', 0);
        let bidAmount = propDoc.get('financialBidAmount', 0);
        let quoted = propDoc.get('quotedAmount', 0);
        let expectedAwarded = totalProposed > 0 ? totalProposed : (
          baseProposed > 0 ? baseProposed : (
            bidAmount > 0 ? bidAmount : (
              quoted > 0 ? quoted : expectedSanctioned
            )
          )
        );
        return incoming().sanctionedAmount == expectedSanctioned
          && (incoming().awardedAmount == expectedAwarded || incoming().awardedAmount == expectedSanctioned);
      }

      // Project Immutable Linkage & Controlled Update Lifecycle Security
      function isImmutableProjectLinkagePreserved() {
        return isValidId(projectId)
          && incoming().id == existing().id
          && incoming().proposalId == existing().proposalId
          && incoming().tenderId == existing().tenderId
          && incoming().organizationId == existing().organizationId
          && incoming().get('projectNumber', '') == existing().get('projectNumber', '')
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && incoming().sanctionedAmount == existing().sanctionedAmount
          && incoming().awardedAmount == existing().awardedAmount;
      }

      function isValidPhysicalProgressValues() {
        return incoming().physicalProgressPercent is number
          && incoming().physicalProgressPercent >= 0
          && incoming().physicalProgressPercent <= 100
          && incoming().physicalProgress is number
          && incoming().physicalProgress == incoming().physicalProgressPercent;
      }

      function isValidFinancialProgressValues() {
        return incoming().financialProgressPercent is number
          && incoming().financialProgressPercent >= 0
          && incoming().financialProgressPercent <= 100
          && incoming().financialProgress is number
          && incoming().financialProgress == incoming().financialProgressPercent
          && incoming().utilizedAmount is number
          && incoming().utilizedAmount >= 0;
      }

      function isValidFinancialProgressRecalculation() {
        let finRec = getAfter(/databases/$(database)/documents/projectFinancialRecords/$(incoming().lastVerifiedRecordId)).data;
        let addedUtil = (finRec.verificationStatus == 'VERIFIED') ? finRec.amount : 0;
        let expectedUtil = existing().utilizedAmount + addedUtil;
        let awarded = existing().awardedAmount > 0 ? existing().awardedAmount : (existing().sanctionedAmount > 0 ? existing().sanctionedAmount : 1);
        let expectedRawPercent = (expectedUtil * 100) / awarded;
        let expectedCappedPercent = expectedRawPercent > 100 ? 100 : expectedRawPercent;
        return incoming().utilizedAmount == expectedUtil
          && incoming().amountDisbursed == expectedUtil
          && incoming().disbursedAmount == expectedUtil
          && (
            (expectedCappedPercent == 100 && incoming().financialProgressPercent == 100)
            ||
            (incoming().financialProgressPercent - expectedCappedPercent <= 1 && expectedCappedPercent - incoming().financialProgressPercent <= 1)
          );
      }

      allow update: if isSignedIn()
        && isImmutableProjectLinkagePreserved()
        && (
          // Path 1: Government status transition (cannot mutate monitoring or baseline fields)
          (
            isGovernmentUser()
            && isValidProjectStatusTransition(existing().status, incoming().status)
            && incoming().status != existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'actualCompletionDate', 'completionChecklist', 'updatedAt', 'implementationStartDate', 'lastStatusChangeEventId'
            ])
            && (
              (existing().keys().hasAny(['implementationStartDate']) && incoming().get('implementationStartDate', '') == existing().get('implementationStartDate', ''))
              ||
              (!existing().keys().hasAny(['implementationStartDate']) && (
                (incoming().status == 'IN_PROGRESS' && incoming().get('implementationStartDate', '') is string)
                ||
                (incoming().status != 'IN_PROGRESS' && !incoming().keys().hasAny(['implementationStartDate']))
              ))
            )
            && (
              (existing().status == 'COMPLETED' && incoming().status == 'CLOSED'
               && incoming().get('actualCompletionDate', '') == existing().get('actualCompletionDate', '')
               && incoming().get('completionChecklist', {}) == existing().get('completionChecklist', {}))
              ||
              (incoming().status == 'COMPLETED'
               && incoming().get('actualCompletionDate', '') is string
               && incoming().completionChecklist is map
               && incoming().completionChecklist.physicalWorkCompleted == true
               && incoming().completionChecklist.finalMilestoneCompleted == true
               && incoming().completionChecklist.financialRecordsReviewed == true
               && incoming().completionChecklist.finalInspectionCompleted == true
               && incoming().completionChecklist.supportingInformationAvailable == true)
              ||
              (incoming().status != 'COMPLETED' && existing().status != 'COMPLETED'
               && !incoming().keys().hasAny(['actualCompletionDate', 'completionChecklist']))
            )
            && incoming().get('lastStatusChangeEventId', '') is string
            && incoming().get('lastStatusChangeEventId', '').size() > 0
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(incoming().lastStatusChangeEventId)).data.action == 'STATUS_CHANGED'
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(incoming().lastStatusChangeEventId)).data.projectId == projectId
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(incoming().lastStatusChangeEventId)).data.actorId == request.auth.uid
          )
          ||
          // Path 2: Physical progress recalculation (controlled government-authorized operation linked to milestone mutation)
          (
            isGovernmentUser()
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'physicalProgressPercent', 'physicalProgress', 'updatedAt', 'lastMilestoneId', 'milestonesSummary'
            ])
            && isValidPhysicalProgressValues()
            && incoming().get('lastMilestoneId', '') is string
            && incoming().get('lastMilestoneId', '').size() > 0
            && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.projectId == projectId
            && (
              (
                getAfter(/databases/$(database)/documents/projectAuditEvents/$(milestoneCreatedAuditId(incoming().lastMilestoneId))).data.action == 'MILESTONE_CREATED'
                && getAfter(/databases/$(database)/documents/projectAuditEvents/$(milestoneCreatedAuditId(incoming().lastMilestoneId))).data.projectId == projectId
              )
              ||
              (
                getAfter(/databases/$(database)/documents/projectAuditEvents/$(getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.lastAuditEventId)).data.action == 'MILESTONE_UPDATED'
                && getAfter(/databases/$(database)/documents/projectAuditEvents/$(getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.lastAuditEventId)).data.projectId == projectId
              )
            )
          )
          ||
          // Path 3: Financial progress recalculation (driven by government verification of expenditure claims)
          (
            isGovernmentUser()
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'financialProgressPercent', 'financialProgress', 'utilizedAmount', 'amountDisbursed', 'disbursedAmount', 'updatedAt', 'lastVerifiedRecordId'
            ])
            && isValidFinancialProgressValues()
            && incoming().get('lastVerifiedRecordId', '') is string
            && incoming().get('lastVerifiedRecordId', '').size() > 0
            && get(/databases/$(database)/documents/projectFinancialRecords/$(incoming().lastVerifiedRecordId)).data.verificationStatus == 'PENDING'
            && getAfter(/databases/$(database)/documents/projectFinancialRecords/$(incoming().lastVerifiedRecordId)).data.verificationStatus in ['VERIFIED', 'REJECTED']
            && getAfter(/databases/$(database)/documents/projectFinancialRecords/$(incoming().lastVerifiedRecordId)).data.projectId == projectId
            && isValidFinancialProgressRecalculation()
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(financialVerifiedAuditId(incoming().lastVerifiedRecordId))).data.projectId == projectId
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(financialVerifiedAuditId(incoming().lastVerifiedRecordId))).data.action in ['FINANCIAL_RECORD_VERIFIED', 'FINANCIAL_RECORD_REJECTED']
          )
          ||
          // Path 4: Agency physical progress recalculation (atomically linked to agency progress update & milestone update)
          (
            isVerifiedAgency()
            && existing().organizationId == getUserOrgId()
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'physicalProgressPercent', 'physicalProgress', 'updatedAt', 'lastProgressUpdateId', 'lastMilestoneId', 'milestonesSummary'
            ])
            && isValidPhysicalProgressValues()
            && incoming().get('lastProgressUpdateId', '') is string
            && incoming().get('lastProgressUpdateId', '').size() > 0
            && !exists(/databases/$(database)/documents/projectProgressUpdates/$(incoming().lastProgressUpdateId))
            && getAfter(/databases/$(database)/documents/projectProgressUpdates/$(incoming().lastProgressUpdateId)).data.projectId == projectId
            && getAfter(/databases/$(database)/documents/projectProgressUpdates/$(incoming().lastProgressUpdateId)).data.submittedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/projectProgressUpdates/$(incoming().lastProgressUpdateId)).data.submittedByRole == 'AGENCY'
            && incoming().get('lastMilestoneId', '') is string
            && incoming().get('lastMilestoneId', '').size() > 0
            && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.projectId == projectId
            && (
              (getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.status == 'NOT_STARTED'
               && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.progressPercent == 0) ||
              (getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.status == 'IN_PROGRESS'
               && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.progressPercent > 0
               && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.progressPercent < 100) ||
              (getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.status == 'COMPLETED'
               && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.progressPercent == 100) ||
              (getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.status == 'DELAYED'
               && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.progressPercent >= 0
               && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().lastMilestoneId)).data.progressPercent < 100)
            )
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(progressSubmittedAuditId(incoming().lastProgressUpdateId))).data.action == 'PROGRESS_UPDATE_SUBMITTED'
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(progressSubmittedAuditId(incoming().lastProgressUpdateId))).data.projectId == projectId
          ));

      allow delete: if false;
    }

    // 10. Project Milestones (/projectMilestones/{milestoneId})
    match /projectMilestones/{milestoneId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
         && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.organizationId == getUserOrgId())
      );

      allow create: if isSignedIn() && isGovernmentUser() && isValidId(milestoneId)
        && incoming().id == milestoneId
        && incoming().projectId is string
        && (
          exists(/databases/$(database)/documents/projects/$(incoming().projectId)) ||
          getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.id == incoming().projectId
        )
        && incoming().sequence is number
        && incoming().sequence >= 1
        && incoming().weightPercent is number
        && incoming().weightPercent >= 0
        && incoming().weightPercent <= 100
        && incoming().progressPercent is number
        && incoming().progressPercent >= 0
        && incoming().progressPercent <= 100
        && incoming().status in ['NOT_STARTED', 'IN_PROGRESS', 'COMPLETED', 'DELAYED']
        && incoming().createdAt is string
        && incoming().updatedAt is string
        && (
          (incoming().status == 'NOT_STARTED' && incoming().progressPercent == 0) ||
          (incoming().status == 'IN_PROGRESS' && incoming().progressPercent > 0 && incoming().progressPercent < 100) ||
          (incoming().status == 'COMPLETED' && incoming().progressPercent == 100) ||
          (incoming().status == 'DELAYED')
        )
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(milestoneCreatedAuditId(milestoneId))).data.action == 'MILESTONE_CREATED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(milestoneCreatedAuditId(milestoneId))).data.projectId == incoming().projectId;

      // Milestone Immutability: Government configures structure; Agency updates only progress fields
      allow update: if isSignedIn()
        && incoming().get('lastAuditEventId', '') is string
        && incoming().get('lastAuditEventId', '').size() > 0
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(incoming().lastAuditEventId)).data.action == 'MILESTONE_UPDATED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(incoming().lastAuditEventId)).data.projectId == incoming().projectId
        && (
        // Case 1: Government configuration
        (
          isGovernmentUser()
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && incoming().sequence is number
          && incoming().sequence >= 1
          && incoming().weightPercent is number
          && incoming().weightPercent >= 0
          && incoming().weightPercent <= 100
          && incoming().progressPercent is number
          && incoming().progressPercent >= 0
          && incoming().progressPercent <= 100
          && incoming().status in ['NOT_STARTED', 'IN_PROGRESS', 'COMPLETED', 'DELAYED']
          && (!incoming().keys().hasAny(['plannedStartDate']) || incoming().plannedStartDate is string)
          && (!incoming().keys().hasAny(['plannedEndDate']) || incoming().plannedEndDate is string)
          && incoming().updatedAt is string
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'description',
            'sequence',
            'plannedStartDate',
            'plannedEndDate',
            'weightPercent',
            'progressPercent',
            'status',
            'actualStartDate',
            'actualEndDate',
            'updatedAt',
            'lastAuditEventId'
          ])
          && (
            (incoming().status == 'NOT_STARTED' && incoming().progressPercent == 0) ||
            (incoming().status == 'IN_PROGRESS' && incoming().progressPercent > 0 && incoming().progressPercent < 100) ||
            (incoming().status == 'COMPLETED' && incoming().progressPercent == 100) ||
            (incoming().status == 'DELAYED' && incoming().progressPercent >= 0 && incoming().progressPercent < 100)
          )
        )
        ||
        // Case 2: Agency operational progress update
        (
          isVerifiedAgency()
          && exists(/databases/$(database)/documents/projects/$(existing().projectId))
          && get(/databases/$(database)/documents/projects/$(existing().projectId)).data.organizationId == getUserOrgId()
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().sequence == existing().sequence
          && incoming().title == existing().title
          && incoming().get('description', '') == existing().get('description', '')
          && incoming().get('plannedStartDate', '') == existing().get('plannedStartDate', '')
          && incoming().get('plannedEndDate', '') == existing().get('plannedEndDate', '')
          && incoming().weightPercent == existing().weightPercent
          && incoming().get('createdAt', '') == existing().get('createdAt', '')
          && incoming().progressPercent is number
          && incoming().progressPercent >= 0
          && incoming().progressPercent <= 100
          && incoming().status in ['NOT_STARTED', 'IN_PROGRESS', 'COMPLETED', 'DELAYED']
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'progressPercent', 'status', 'actualStartDate', 'actualEndDate', 'updatedAt', 'lastAuditEventId'
          ])
          && (
            (incoming().status == 'NOT_STARTED' && incoming().progressPercent == 0) ||
            (incoming().status == 'IN_PROGRESS' && incoming().progressPercent > 0 && incoming().progressPercent < 100) ||
            (incoming().status == 'COMPLETED' && incoming().progressPercent == 100) ||
            (incoming().status == 'DELAYED' && incoming().progressPercent >= 0 && incoming().progressPercent < 100)
          )
        )
      );

      // Direct deletion denied to protect progress recalculation and audit trail integrity
      allow delete: if false;
    }

    // 11. Project Progress Updates (/projectProgressUpdates/{updateId})
    match /projectProgressUpdates/{updateId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
         && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.organizationId == getUserOrgId())
      );

      // Progress Update Integrity: Append-only, authoritative role binding
      allow create: if isSignedIn()
        && isValidId(updateId)
        && incoming().id == updateId
        && incoming().submittedBy == request.auth.uid
        && (!incoming().keys().hasAny(['physicalProgressPercent']) || (incoming().physicalProgressPercent is number && incoming().physicalProgressPercent >= 0 && incoming().physicalProgressPercent <= 100))
        && incoming().projectId is string
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && (
          // Case 1: Government submission
          (
            isGovernmentUser()
            && incoming().submittedByRole == 'GOVERNMENT'
          )
          ||
          // Case 2: Agency submission bound to project organization
          (
            isVerifiedAgency()
            && incoming().submittedByRole == 'AGENCY'
            && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.organizationId == getUserOrgId()
          )
        )
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(progressSubmittedAuditId(updateId))).data.action == 'PROGRESS_UPDATE_SUBMITTED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(progressSubmittedAuditId(updateId))).data.projectId == incoming().projectId;

      allow update, delete: if false;
    }

    // 12. Project Financial Records (/projectFinancialRecords/{recordId})
    match /projectFinancialRecords/{recordId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
         && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.organizationId == getUserOrgId())
      );

      // Financial Record Integrity: Append-only creation (all new records start as PENDING)
      allow create: if isSignedIn()
        && isValidId(recordId)
        && incoming().id == recordId
        && incoming().amount is number
        && incoming().amount > 0
        && incoming().expenditureType in ['MATERIAL', 'LABOUR', 'EQUIPMENT', 'OTHER']
        && incoming().submittedBy == request.auth.uid
        && incoming().verificationStatus == 'PENDING'
        && incoming().projectId is string
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && (
          // Case 1: Agency expenditure claim
          (
            isVerifiedAgency()
            && incoming().submittedByRole == 'AGENCY'
            && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.organizationId == getUserOrgId()
          )
          ||
          // Case 2: Government record
          (
            isGovernmentUser()
            && incoming().submittedByRole == 'GOVERNMENT'
          )
        )
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(financialSubmittedAuditId(recordId))).data.action == 'FINANCIAL_RECORD_SUBMITTED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(financialSubmittedAuditId(recordId))).data.projectId == incoming().projectId;

      // Government verification: strictly PENDING -> VERIFIED or PENDING -> REJECTED (terminal)
      allow update: if isSignedIn()
        && isGovernmentUser()
        && isValidId(recordId)
        && incoming().id == existing().id
        && incoming().amount == existing().amount
        && incoming().projectId == existing().projectId
        && incoming().submittedBy == existing().submittedBy
        && incoming().submittedByRole == existing().submittedByRole
        && incoming().expenditureType == existing().expenditureType
        && incoming().description == existing().description
        && incoming().get('referenceNumber', '') == existing().get('referenceNumber', '')
        && incoming().get('createdAt', '') == existing().get('createdAt', '')
        && existing().verificationStatus == 'PENDING'
        && incoming().verificationStatus in ['VERIFIED', 'REJECTED']
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'verificationStatus', 'verifiedBy', 'verifiedByName', 'verifiedAt', 'verificationNotes'
        ])
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(financialVerifiedAuditId(recordId))).data.projectId == incoming().projectId
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(financialVerifiedAuditId(recordId))).data.action in ['FINANCIAL_RECORD_VERIFIED', 'FINANCIAL_RECORD_REJECTED'];

      allow delete: if false;
    }

    // 13. Project Inspections (/projectInspections/{inspectionId})
    match /projectInspections/{inspectionId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
         && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.organizationId == getUserOrgId())
      );

      // Append-only official inspections by government officers
      allow create: if isSignedIn()
        && isGovernmentUser()
        && isValidId(inspectionId)
        && incoming().id == inspectionId
        && incoming().inspectionType in ['ROUTINE', 'MILESTONE', 'COMPLAINT', 'FINAL']
        && (!incoming().keys().hasAny(['physicalProgressObserved']) || (incoming().physicalProgressObserved is number && incoming().physicalProgressObserved >= 0 && incoming().physicalProgressObserved <= 100))
        && incoming().officerId == request.auth.uid
        && incoming().projectId is string
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(inspectionCreatedAuditId(inspectionId))).data.action == 'INSPECTION_CREATED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(inspectionCreatedAuditId(inspectionId))).data.projectId == incoming().projectId;

      allow update, delete: if false;
    }

    // 14. Project Exceptions (/projectExceptions/{exceptionId})
    match /projectExceptions/{exceptionId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
         && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.organizationId == getUserOrgId())
      );

      // Exception Security: Government/system-authorized deterministic exceptions only
      allow create: if isSignedIn()
        && isGovernmentUser()
        && isValidId(exceptionId)
        && incoming().id == exceptionId
        && incoming().source == 'SYSTEM_RULE'
        && incoming().severity in ['LOW', 'MEDIUM', 'HIGH']
        && (
          incoming().type in [
            'SCHEDULE_DELAY',
            'PHYSICAL_PROGRESS_DELAY',
            'FINANCIAL_PROGRESS_MISMATCH',
            'PROGRESS_VARIANCE',
            'EXPENDITURE_OVER_AWARD',
            'STALLED_PROJECT'
          ]
          || incoming().type.matches('^SCHEDULE_DELAY_.*$')
          || incoming().type.matches('^PHYSICAL_PROGRESS_DELAY_.*$')
        )
        && incoming().status == 'OPEN'
        && incoming().projectId is string
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(exceptionDetectedAuditId(exceptionId))).data.action == 'EXCEPTION_DETECTED'
        && getAfter(/databases/$(database)/documents/projectAuditEvents/$(exceptionDetectedAuditId(exceptionId))).data.projectId == incoming().projectId;

      // Government-only status/resolution updates
      allow update: if isSignedIn()
        && isGovernmentUser()
        && isValidId(exceptionId)
        && incoming().id == existing().id
        && incoming().projectId == existing().projectId
        && incoming().source == existing().source
        && incoming().type == existing().type
        && incoming().get('detectedAt', '') == existing().get('detectedAt', '')
        && (
          (
            existing().status == 'OPEN' && incoming().status == 'ACKNOWLEDGED'
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(exceptionAcknowledgedAuditId(exceptionId))).data.action == 'EXCEPTION_ACKNOWLEDGED'
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(exceptionAcknowledgedAuditId(exceptionId))).data.projectId == incoming().projectId
          ) ||
          (
            existing().status == 'ACKNOWLEDGED' && incoming().status == 'RESOLVED'
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(exceptionResolvedAuditId(exceptionId))).data.action == 'EXCEPTION_RESOLVED'
            && getAfter(/databases/$(database)/documents/projectAuditEvents/$(exceptionResolvedAuditId(exceptionId))).data.projectId == incoming().projectId
          )
        )
        && (
          incoming().status != 'RESOLVED' ||
          (
            incoming().get('resolvedBy', '') == request.auth.uid &&
            incoming().get('resolvedAt', '') is string &&
            incoming().get('resolvedAt', '').size() > 0 &&
            incoming().get('resolutionNote', '') is string &&
            incoming().get('resolutionNote', '').trim().size() >= 10
          )
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'resolutionNote'
        ]);

      allow delete: if false;
    }

    // 15. Project Audit Events (/projectAuditEvents/{eventId})
    match /projectAuditEvents/{eventId} {
      allow get, list: if isSignedIn() && (
        isGovernmentUser() ||
        (isVerifiedAgency() && exists(/databases/$(database)/documents/projects/$(resource.data.projectId))
         && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.organizationId == getUserOrgId())
      );

      function isValidAuditMutation() {
        return (
          // PROJECT_CREATED -> project created in getAfter()
          (incoming().action == 'PROJECT_CREATED'
           && !exists(/databases/$(database)/documents/projects/$(incoming().projectId))
           && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.id == incoming().projectId) ||

          // STATUS_CHANGED -> project status changed in getAfter()
          (incoming().action == 'STATUS_CHANGED'
           && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
           && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.status != get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.status
           && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.lastStatusChangeEventId == eventId) ||

          // MILESTONE_CREATED -> referenced milestone created in getAfter()
          (incoming().action == 'MILESTONE_CREATED'
           && incoming().get('newState', {}).get('milestoneId', '') is string
           && !exists(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId))
           && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.projectId == incoming().projectId) ||

          // MILESTONE_UPDATED -> referenced milestone changed in getAfter()
          (incoming().action == 'MILESTONE_UPDATED'
           && incoming().get('newState', {}).get('milestoneId', '') is string
           && exists(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId))
           && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.projectId == incoming().projectId
           && getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.lastAuditEventId == eventId
           && (getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.progressPercent != get(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.progressPercent
               || getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.status != get(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.status
               || getAfter(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.updatedAt != get(/databases/$(database)/documents/projectMilestones/$(incoming().newState.milestoneId)).data.updatedAt)) ||

          // PROGRESS_UPDATE_SUBMITTED -> referenced progress update created in getAfter()
          (incoming().action == 'PROGRESS_UPDATE_SUBMITTED'
           && incoming().get('newState', {}).get('updateId', '') is string
           && !exists(/databases/$(database)/documents/projectProgressUpdates/$(incoming().newState.updateId))
           && getAfter(/databases/$(database)/documents/projectProgressUpdates/$(incoming().newState.updateId)).data.projectId == incoming().projectId) ||

          // FINANCIAL_RECORD_SUBMITTED -> referenced financial record created in getAfter()
          (incoming().action == 'FINANCIAL_RECORD_SUBMITTED'
           && incoming().get('newState', {}).get('recordId', '') is string
           && !exists(/databases/$(database)/documents/projectFinancialRecords/$(incoming().newState.recordId))
           && getAfter(/databases/$(database)/documents/projectFinancialRecords/$(incoming().newState.recordId)).data.projectId == incoming().projectId) ||

          // FINANCIAL_RECORD_VERIFIED / REJECTED -> referenced financial record changed in getAfter()
          (incoming().action in ['FINANCIAL_RECORD_VERIFIED', 'FINANCIAL_RECORD_REJECTED']
           && incoming().get('newState', {}).get('recordId', '') is string
           && exists(/databases/$(database)/documents/projectFinancialRecords/$(incoming().newState.recordId))
           && getAfter(/databases/$(database)/documents/projectFinancialRecords/$(incoming().newState.recordId)).data.projectId == incoming().projectId
           && getAfter(/databases/$(database)/documents/projectFinancialRecords/$(incoming().newState.recordId)).data.verificationStatus != get(/databases/$(database)/documents/projectFinancialRecords/$(incoming().newState.recordId)).data.verificationStatus) ||

          // INSPECTION_CREATED -> referenced inspection created in getAfter()
          (incoming().action == 'INSPECTION_CREATED'
           && incoming().get('newState', {}).get('inspectionId', '') is string
           && !exists(/databases/$(database)/documents/projectInspections/$(incoming().newState.inspectionId))
           && getAfter(/databases/$(database)/documents/projectInspections/$(incoming().newState.inspectionId)).data.projectId == incoming().projectId) ||

          // EXCEPTION_DETECTED -> referenced exception created in getAfter()
          (incoming().action == 'EXCEPTION_DETECTED'
           && incoming().get('newState', {}).get('exceptionId', '') is string
           && !exists(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId))
           && getAfter(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId)).data.projectId == incoming().projectId) ||

          // EXCEPTION_ACKNOWLEDGED / RESOLVED -> referenced exception changed in getAfter()
          (incoming().action in ['EXCEPTION_ACKNOWLEDGED', 'EXCEPTION_RESOLVED']
           && incoming().get('newState', {}).get('exceptionId', '') is string
           && exists(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId))
           && getAfter(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId)).data.projectId == incoming().projectId
           && (getAfter(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId)).data.status != get(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId)).data.status
               || getAfter(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId)).data.get('resolvedAt', '') != get(/databases/$(database)/documents/projectExceptions/$(incoming().newState.exceptionId)).data.get('resolvedAt', ''))) ||

          // PROJECT_UPDATED -> project changed in getAfter()
          (incoming().action == 'PROJECT_UPDATED'
           && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
           && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.updatedAt != get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.updatedAt)
        );
      }

      // Audit Trail Security: Append-only, strict actor role & ownership binding
      allow create: if isSignedIn()
        && isValidId(eventId)
        && incoming().eventId == eventId
        && incoming().actorId == request.auth.uid
        && incoming().projectId is string
        && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.id == incoming().projectId
        && isValidAuditMutation()
        && (
          // Case 1: Agency actions
          (
            isVerifiedAgency()
            && incoming().actorRole == 'agency'
            && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.organizationId == getUserOrgId()
            && incoming().action in [
              'PROGRESS_UPDATE_SUBMITTED',
              'FINANCIAL_RECORD_SUBMITTED',
              'MILESTONE_UPDATED'
            ]
          )
          ||
          // Case 2: Government actions
          (
            isGovernmentUser()
            && incoming().actorRole == 'government'
            && incoming().action in [
              'PROJECT_CREATED',
              'PROJECT_UPDATED',
              'STATUS_CHANGED',
              'MILESTONE_CREATED',
              'MILESTONE_UPDATED',
              'PROGRESS_UPDATE_SUBMITTED',
              'FINANCIAL_RECORD_SUBMITTED',
              'FINANCIAL_RECORD_VERIFIED',
              'FINANCIAL_RECORD_REJECTED',
              'INSPECTION_CREATED',
              'EXCEPTION_DETECTED',
              'EXCEPTION_ACKNOWLEDGED',
              'EXCEPTION_RESOLVED'
            ]
          )
        );

      allow update, delete: if false;
    }
  }
}

