# Bharat Tender Intelligence (BTI) — Environment Variables
# Configure in .env for local development or in Vercel Project Settings

# ==============================================================================
# Client-Side Configuration (Vite/React Web Client)
# Note: Variables prefixed with VITE_ are bundled into client code.
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# Server-Only Configuration (Node.js / Vercel Serverless API Routes)
# CRITICAL: DO NOT prefix with VITE_. These must NEVER be exposed to the client.
# ==============================================================================
# Google Gemini API Key for Phase 5 AI Proposal Intelligence (Server-Only)
GEMINI_API_KEY=""

# Firebase / Google Cloud Project ID for Server-Side Authoritative Firestore Access (Server-Only)
FIREBASE_PROJECT_ID=""

# Firebase Service Account Key JSON for Server-Side Authoritative Firestore Access (Server-Only)
# CRITICAL SECURITY RULE: This contains private keys and MUST NEVER be exposed through VITE_ variables or client bundles.
FIREBASE_SERVICE_ACCOUNT_KEY=""
