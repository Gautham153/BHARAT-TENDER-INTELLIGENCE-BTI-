{
  "entities": {
    "User": {
      "title": "User",
      "description": "Bharat Tender Intelligence user profile record with RBAC and verification details",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["government", "agency", "public"]
        },
        "organizationId": {
          "type": "string",
          "maxLength": 100
        },
        "organizationName": {
          "type": "string",
          "maxLength": 200
        },
        "designation": {
          "type": "string",
          "maxLength": 200
        },
        "department": {
          "type": "string",
          "maxLength": 200
        },
        "gstin": {
          "type": "string",
          "maxLength": 15
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "verified": {
          "type": "boolean"
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["not_started", "pending", "verified", "failed", "requires_review"]
        },
        "applicationId": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["uid", "email", "role", "verificationStatus"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Statutory Organization & GSTIN verification record",
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "maxLength": 100
        },
        "legalName": {
          "type": "string",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "maxLength": 200
        },
        "gstin": {
          "type": "string",
          "maxLength": 15
        },
        "gstStateCode": {
          "type": "string",
          "maxLength": 2
        },
        "businessCategory": {
          "type": "string",
          "maxLength": 100
        },
        "registeredAddress": {
          "type": "string",
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["not_started", "pending", "verified", "failed", "requires_review"]
        },
        "verificationProvider": {
          "type": "string",
          "maxLength": 100
        },
        "verificationReference": {
          "type": "string",
          "maxLength": 100
        },
        "verificationRequestedAt": {
          "type": "string",
          "maxLength": 50
        },
        "verificationCompletedAt": {
          "type": "string",
          "maxLength": 50
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 500
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 200
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 30
        },
        "primaryUserId": {
          "type": "string",
          "maxLength": 128
        },
        "verified": {
          "type": "boolean"
        },
        "applicationId": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["organizationId", "legalName", "gstin", "verificationStatus", "primaryUserId"]
    },
    "VerificationEvent": {
      "title": "VerificationEvent",
      "description": "Immutable verification audit trail event",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "maxLength": 100
        },
        "organizationId": {
          "type": "string",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "enum": ["SUBMITTED", "VERIFICATION_STARTED", "VERIFICATION_COMPLETED", "MARKED_FOR_REVIEW", "APPROVED", "REJECTED", "RETRY_REQUESTED"]
        },
        "actorId": {
          "type": "string",
          "maxLength": 128
        },
        "actorName": {
          "type": "string",
          "maxLength": 200
        },
        "actorRole": {
          "type": "string",
          "enum": ["government", "agency", "system"]
        },
        "previousStatus": {
          "type": "string",
          "maxLength": 50
        },
        "newStatus": {
          "type": "string",
          "maxLength": 50
        },
        "timestamp": {
          "type": "string",
          "maxLength": 50
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "reference": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["eventId", "organizationId", "action", "actorId", "actorName", "actorRole", "timestamp"]
    },
    "Tender": {
      "title": "Tender",
      "description": "Government tender document under MPLAD scheme procurement",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100
        },
        "tenderNumber": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "subCategory": {
          "type": "string",
          "maxLength": 100
        },
        "issuingAuthority": {
          "type": "string",
          "maxLength": 200
        },
        "department": {
          "type": "string",
          "maxLength": 200
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "constituency": {
          "type": "string",
          "maxLength": 100
        },
        "projectLocation": {
          "type": "string",
          "maxLength": 300
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "sanctionedAmount": {
          "type": "number"
        },
        "estimatedValue": {
          "type": "number"
        },
        "estimatedCost": {
          "type": "number"
        },
        "durationValue": {
          "type": "number"
        },
        "durationUnit": {
          "type": "string",
          "enum": ["days", "weeks", "months"]
        },
        "publicationDate": {
          "type": "string",
          "maxLength": 50
        },
        "closingDate": {
          "type": "string",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PUBLISHED", "LIVE", "CLOSED", "UNDER_EVALUATION", "AWARDED", "CANCELLED", "ARCHIVED"]
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdByName": {
          "type": "string",
          "maxLength": 200
        },
        "createdByEmail": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 50
        },
        "closedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "tenderNumber", "title", "category", "status", "createdBy", "createdAt"]
    },
    "TenderAuditEvent": {
      "title": "TenderAuditEvent",
      "description": "Immutable lifecycle audit event for tender state transitions",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "maxLength": 100
        },
        "tenderId": {
          "type": "string",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "enum": ["CREATED", "UPDATED", "PUBLISHED", "CLOSED", "CANCELLED", "ARCHIVED"]
        },
        "actorId": {
          "type": "string",
          "maxLength": 128
        },
        "actorRole": {
          "type": "string",
          "enum": ["government", "system"]
        },
        "actorName": {
          "type": "string",
          "maxLength": 200
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 200
        },
        "timestamp": {
          "type": "string",
          "maxLength": 50
        },
        "previousStatus": {
          "type": "string",
          "maxLength": 50
        },
        "newStatus": {
          "type": "string",
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": ["eventId", "tenderId", "action", "actorId", "actorRole", "timestamp", "newStatus"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile collection partitioned by Firebase Auth UID"
    },
    "/organizations/{organizationId}": {
      "schema": "Organization",
      "description": "Organization documents storing statutory registration and verification state"
    },
    "/verificationEvents/{eventId}": {
      "schema": "VerificationEvent",
      "description": "Append-only audit trail for verification transitions"
    },
    "/tenders/{tenderId}": {
      "schema": "Tender",
      "description": "Government tenders published under MPLAD scheme"
    },
    "/tenderEvents/{eventId}": {
      "schema": "TenderAuditEvent",
      "description": "Append-only audit events tracking tender lifecycle actions"
    }
  }
}

