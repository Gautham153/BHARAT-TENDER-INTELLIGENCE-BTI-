        "eventId": {
          "type": "string",
          "maxLength": 100
        },
        "tenderId": {
          "type": "string",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "enum": ["CREATED", "UPDATED", "PUBLISHED", "CLOSED", "CANCELLED", "ARCHIVED"]
        },
        "actorId": {
          "type": "string",
          "maxLength": 128
        },
        "actorRole": {
          "type": "string",
