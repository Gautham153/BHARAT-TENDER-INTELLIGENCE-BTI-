    "ProposalAuditEvent": {
      "title": "ProposalAuditEvent",
      "description": "Immutable lifecycle audit event for proposal state transitions",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "maxLength": 100
        },
        "proposalId": {
          "type": "string",
          "maxLength": 100
        },
        "tenderId": {
          "type": "string",
          "maxLength": 100
        },
        "organizationId": {
          "type": "string",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "enum": ["CREATED", "UPDATED", "SUBMITTED", "WITHDRAWN", "UNDER_REVIEW", "SHORTLISTED", "REJECTED", "AWARDED", "AI_EVALUATION_REQUESTED", "AI_EVALUATION_COMPLETED", "AI_EVALUATION_FAILED"]
        },
        "actorId": {
          "type": "string",
          "maxLength": 128
        },
        "actorRole": {
