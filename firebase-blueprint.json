          "type": "string",
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["not_started", "pending", "verified", "failed", "requires_review"]
        },
