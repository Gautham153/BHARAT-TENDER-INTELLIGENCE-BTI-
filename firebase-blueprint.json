        "id": {
          "type": "string",
          "maxLength": 100
        },
        "proposalNumber": {
          "type": "string",
          "maxLength": 50
        },
        "tenderId": {
          "type": "string",
          "maxLength": 100
        },
        "organizationId": {
          "type": "string",
          "maxLength": 100
        },
        "submittedBy": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW", "SHORTLISTED", "REJECTED", "WITHDRAWN", "AWARDED"]
