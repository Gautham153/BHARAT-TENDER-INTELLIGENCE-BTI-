          "type": "string",
          "maxLength": 50
        },
        "verificationCompletedAt": {
          "type": "string",
          "maxLength": 50
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500
        },
        "reviewNotes": {
          "type": "string",
          "maxLength": 500
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 200
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 30
        },
        "primaryUserId": {
          "type": "string",
          "maxLength": 128
        },
        "verified": {
          "type": "boolean"
        },
        "applicationId": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["organizationId", "legalName", "gstin", "verificationStatus", "primaryUserId"]
    },
    "VerificationEvent": {
      "title": "VerificationEvent",
      "description": "Immutable verification audit trail event",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "maxLength": 100
        },
        "organizationId": {
          "type": "string",
          "maxLength": 100
        },
        "action": {
          "type": "string",
          "enum": ["SUBMITTED", "VERIFICATION_STARTED", "VERIFICATION_COMPLETED", "MARKED_FOR_REVIEW", "APPROVED", "REJECTED", "RETRY_REQUESTED"]
        },
        "actorId": {
          "type": "string",
          "maxLength": 128
        },
        "actorName": {
          "type": "string",
          "maxLength": 200
        },
        "actorRole": {
          "type": "string",
          "enum": ["government", "agency", "system"]
        },
        "previousStatus": {
          "type": "string",
          "maxLength": 50
        },
        "newStatus": {
          "type": "string",
          "maxLength": 50
        },
        "timestamp": {
          "type": "string",
          "maxLength": 50
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "reference": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["eventId", "organizationId", "action", "actorId", "actorName", "actorRole", "timestamp"]
    },
    "Tender": {
      "title": "Tender",
      "description": "Government tender document under MPLAD scheme procurement",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100
        },
        "tenderNumber": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "subCategory": {
          "type": "string",
          "maxLength": 100
        },
        "issuingAuthority": {
          "type": "string",
          "maxLength": 200
        },
        "department": {
          "type": "string",
          "maxLength": 200
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "constituency": {
          "type": "string",
          "maxLength": 100
        },
        "projectLocation": {
          "type": "string",
          "maxLength": 300
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "sanctionedAmount": {
          "type": "number"
        },
        "estimatedValue": {
          "type": "number"
        },
        "estimatedCost": {
          "type": "number"
        },
        "durationValue": {
          "type": "number"
        },
        "durationUnit": {
          "type": "string",
          "enum": ["days", "weeks", "months"]
        },
        "publicationDate": {
          "type": "string",
          "maxLength": 50
        },
        "closingDate": {
          "type": "string",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PUBLISHED", "LIVE", "CLOSED", "UNDER_EVALUATION", "AWARDED", "CANCELLED", "ARCHIVED"]
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdByName": {
          "type": "string",
          "maxLength": 200
        },
        "createdByEmail": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 50
        },
        "closedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["id", "tenderNumber", "title", "category", "status", "createdBy", "createdAt"]
    },
    "TenderAuditEvent": {
      "title": "TenderAuditEvent",
